OPENTOPOGRAPHY_API_KEY=
ICESAT_API_KEY=
CDSE_CLIENT_ID=
CDSE_CLIENT_SECRET=

# Cloudflare R2 (tile library + Method 6 checkpoints) — see docs/R2_SETUP.md.
# Leave R2_PUBLIC_BASE_URL empty to keep the bucket private (presigned URLs).
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=depthwizard2
R2_PUBLIC_BASE_URL=

# Browser origins allowed to call this backend (comma-separated, exact, no trailing slash).
# Local: http://localhost:5173. Deployed: add the Vercel URL, e.g. https://<app>.vercel.app
CORS_ORIGINS=http://localhost:5173
# Optional regex, e.g. for Vercel preview deploys: ^https://<app>(-[a-z0-9-]+)?\.vercel\.app$
CORS_ORIGIN_REGEX=

# Relative-depth (DAv2-Small) inference host, read per request by /api/depth/* (docs/DEPLOY.md).
# A Hugging Face Space id (called via the Gradio API with HF_TOKEN) or a plain http(s) /predict URL.
# Empty = the ZeroGPU Space sancharimouri/DepthWizard2.
DAV2_INFERENCE_URL=sancharimouri/DepthWizard2
# Explicit fallback, tried only when set and the primary fails, e.g. the Colab bridge's
# trycloudflare.com URL (bridge/dav2_colab_bridge.ipynb). Empty = no fallback.
DAV2_FALLBACK_URL=
